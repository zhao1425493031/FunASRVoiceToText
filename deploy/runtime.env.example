# Copy to deploy/runtime.env and adjust for your host

# FunASR Runtime WebSocket port (host mapping)
RUNTIME_PORT=10095

# Host directory mounted to /workspace/models inside runtime container
RUNTIME_MODEL_DIR=./models

# --- Enterprise Japanese (recommended, Runtime >= 1.12) ---
# 2pass-offline: SenseVoiceSmall with ONNX export under models/iic/SenseVoiceSmall/
# See https://github.com/modelscope/FunASR/issues/2035
RUNTIME_MODEL_PATH=iic/SenseVoiceSmall
RUNTIME_ONLINE_MODEL_PATH=damo/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-online-onnx

# --- Chinese 2pass (legacy default) ---
# RUNTIME_MODEL_PATH=damo/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-onnx
# RUNTIME_ONLINE_MODEL_PATH=damo/speech_paraformer-large_asr_nat-zh-cn-16k-common-vocab8404-online-onnx

# Gateway HTTP/HTTPS port
GATEWAY_PORT=8765
