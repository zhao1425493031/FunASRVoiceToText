{
  "job_id": "125a4f41-1718-4d57-86fb-e85388861a55",
  "language": "ja",
  "duration_ms": 100969,
  "segments": [
    {
      "start_ms": 1026,
      "end_ms": 6308,
      "speaker_id": "SPEAKER_00",
      "text": "お疲れ様です先週ご相談した案件の進捗について確認させてください。"
    },
    {
      "start_ms": 8147,
      "end_ms": 15235,
      "speaker_id": "SPEAKER_01",
      "text": "お疲れ様です。現在基本設計は完了しており、開発作業は約七十五パーセントまで進んでいます。"
    },
    {
      "start_ms": 15572,
      "end_ms": 18880,
      "speaker_id": "SPEAKER_00",
      "text": "テスト環境の準備状況はいかがでしょうか。"
    },
    {
      "start_ms": 20247,
      "end_ms": 25259,
      "speaker_id": "SPEAKER_01",
      "text": "サーバーの構築は完了しましたので、明日から内部テストを開始する予定です。"
    },
    {
      "start_ms": 26119,
      "end_ms": 32380,
      "speaker_id": "SPEAKER_00",
      "text": "承知しました。前回課題になっていた処理速度の問題は改善されていますか。"
    },
    {
      "start_ms": 33899,
      "end_ms": 41560,
      "speaker_id": "SPEAKER_01",
      "text": "プログラムを見直した結果、平均処理時間を約 2秒から0.6秒まで短縮できました。"
    },
    {
      "start_ms": 41560,
      "end_ms": 49255,
      "speaker_id": "SPEAKER_00",
      "text": "それはいいですね。お客様から追加要望が出ていた帳票機能についてはどうでしょうか。"
    },
    {
      "start_ms": 50925,
      "end_ms": 57777,
      "speaker_id": "SPEAKER_01",
      "text": "開発工数を見積もったところ、三日から五日程度の追加作業で対応可能と考えています。"
    },
    {
      "start_ms": 58620,
      "end_ms": 66197,
      "speaker_id": "SPEAKER_00",
      "text": "わかりました。では、今週中に最新のスケジュールと課題一覧を共有してください。"
    },
    {
      "start_ms": 66197,
      "end_ms": 70686,
      "speaker_id": "SPEAKER_01",
      "text": "承知しました。金曜日の夕方までに関係者へ展開いたします。"
    },
    {
      "start_ms": 71074,
      "end_ms": 76862,
      "speaker_id": "SPEAKER_00",
      "text": "ありがとうございます。ところで、来週のレビュー会議の日程は確定していますか。"
    },
    {
      "start_ms": 77689,
      "end_ms": 82718,
      "speaker_id": "SPEAKER_01",
      "text": "はい。 来週火曜日の午後二時から一時間半を予定しております。"
    },
    {
      "start_ms": 83157,
      "end_ms": 86970,
      "speaker_id": "SPEAKER_00",
      "text": "それでは、レビュー用の資料を事前に準備しておきましょう。"
    },
    {
      "start_ms": 87764,
      "end_ms": 89114,
      "speaker_id": "SPEAKER_01",
      "text": "わかりましたこちらで採用いたします。"
    },
    {
      "start_ms": 89114,
      "end_ms": 95324,
      "speaker_id": "SPEAKER_00",
      "text": "本日の確認事項は以上です。引き続きよろしくお願いたします。"
    },
    {
      "start_ms": 95948,
      "end_ms": 97939,
      "speaker_id": "SPEAKER_01",
      "text": "こちらこそよろしくお願いいたします。"
    }
  ],
